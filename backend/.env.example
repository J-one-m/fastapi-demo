# ==========================================
# 环境变量示例文件
# 用法：复制本文件为 .env，再按需修改取值
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# 注意：.env 已被 .gitignore 忽略，切勿把真实密码/密钥提交到仓库；
#       本文件中的值均为占位符，可安全提交。
# ==========================================

# --- 应用 ---
APP_NAME=FastAPI Project
DEBUG=false

# --- 数据库 ---
# 本地开发默认使用 SQLite。
# 相对路径（如 ./app.db）会在 config.py 中自动锚定到 backend/ 目录，
# 因此无论从哪个目录启动服务或执行迁移，连的都是同一个数据库文件。
# 也可以直接写绝对路径：
# DATABASE_URL=sqlite+aiosqlite:///C:/path/to/project/backend/app.db
DATABASE_URL=sqlite+aiosqlite:///./app.db

# MySQL 连接字符串（需要时启用，并注释掉上面的 SQLite）
# 密码中的特殊字符需要 URL 编码，例如 @ 要写成 %40
# DATABASE_URL=mysql+asyncmy://<user>:<password>@<host>:3306/<database>?charset=utf8mb4

# MySQL 密码（当前代码未直接读取，供参考/后续使用；如已写在 DATABASE_URL 中可删除）
MYSQL_PASSWORD=<your-mysql-password>
